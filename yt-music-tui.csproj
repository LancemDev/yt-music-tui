<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>YtMusicTui</RootNamespace>
    <AssemblyName>yt-music-tui</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="Ratatui.cs" Version="0.3.3" />
    <PackageReference Include="YouTubeMusicAPI" Version="3.0.10" />
    <PackageReference Include="YouTubeSessionGenerator" Version="1.0.3" />
  </ItemGroup>

</Project>
